<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/parameters_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/main"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/action_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:id="@+id/parameters_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="60sp"
                android:text="@string/app_name"
                android:background="@drawable/info"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/main"
                android:padding="20dp"
                android:layout_marginVertical="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="start|center"
                        android:textSize="24sp"
                        android:text="@string/rows"/>

                    <Button
                        android:id="@+id/random1"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="20dp"
                        android:textSize="24sp"
                        android:text="@string/random"
                        android:background="@drawable/cancel"
                        android:textAllCaps="false"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggleGroup1"
                    android:layout_width="match_parent"
                    android:layout_marginVertical="20dp"
                    android:layout_height="40dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/accent"
                        android:gravity="center_vertical|left"
                        android:paddingHorizontal="20dp"
                        android:textSize="24sp"
                        android:text="10"
                        android:inputType="number"/>

                    <Button
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="20dp"
                        android:textSize="24sp"
                        android:text="@string/minus"
                        android:background="@drawable/main"/>

                    <Button
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:textSize="24sp"
                        android:text="@string/plus"
                        android:background="@drawable/main"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggleGroup2"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/toggle1"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="5"
                        android:background="@drawable/main"/>

                    <Button
                        android:id="@+id/toggle2"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="10"
                        android:layout_marginHorizontal="20dp"
                        android:background="@drawable/main"/>

                    <Button
                        android:id="@+id/toggle3"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="20"
                        android:background="@drawable/main"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggleGroup3"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/toggle4"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="50"
                        android:background="@drawable/main"/>

                    <Button
                        android:id="@+id/toggle5"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="100"
                        android:layout_marginHorizontal="20dp"
                        android:background="@drawable/info"/>

                    <Button
                        android:id="@+id/toggle6"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="1000"
                        android:background="@drawable/accent"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/main"
                android:padding="20dp"
                android:layout_marginVertical="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="start|center"
                        android:textSize="24sp"
                        android:text="@string/columns"/>

                    <Button
                        android:id="@+id/random11"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="20dp"
                        android:textSize="24sp"
                        android:text="@string/random"
                        android:background="@drawable/cancel"
                        android:textAllCaps="false"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggleGroup11"
                    android:layout_width="match_parent"
                    android:layout_marginVertical="20dp"
                    android:layout_height="40dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/accent"
                        android:gravity="center_vertical|left"
                        android:paddingHorizontal="20dp"
                        android:textSize="24sp"
                        android:text="10"
                        android:inputType="number"/>

                    <Button
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="20dp"
                        android:textSize="24sp"
                        android:text="@string/minus"
                        android:background="@drawable/main"/>

                    <Button
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:textSize="24sp"
                        android:text="@string/plus"
                        android:background="@drawable/main"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggleGroup12"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/toggle11"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="5"
                        android:background="@drawable/main"/>

                    <Button
                        android:id="@+id/toggle12"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="10"
                        android:layout_marginHorizontal="20dp"
                        android:background="@drawable/main"/>

                    <Button
                        android:id="@+id/toggle13"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="20"
                        android:background="@drawable/main"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toggleGroup13"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/toggle14"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="50"
                        android:background="@drawable/main"/>

                    <Button
                        android:id="@+id/toggle15"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="100"
                        android:layout_marginHorizontal="20dp"
                        android:background="@drawable/info"/>

                    <Button
                        android:id="@+id/toggle16"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="24sp"
                        android:text="1000"
                        android:background="@drawable/accent"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="27sp"
                android:gravity="start|center"
                android:text="@string/mins"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="27sp"
                android:gravity="start|center"
                android:text="@string/show_seconds"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="27sp"
                android:gravity="start|center"
                android:text="@string/radius_cells"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@id/action_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/parameters_scroll">

        <Button
            android:id="@+id/reset_button"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/cancel"
            android:textSize="27sp"
            android:text="@string/reset"
            android:textAllCaps="false"/>

        <Space
            android:layout_width="20dp"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/start_game_button"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/accent"
            android:textSize="27sp"
            android:text="@string/begin_game"
            android:textAllCaps="false"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>